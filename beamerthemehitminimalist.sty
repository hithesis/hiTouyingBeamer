% --------------------------------------------------- navigation auto-fit & outline ----
\newcount\hit@meas@linecount
\newdimen\hit@meas@maxlinewidth
\newdimen\hit@meas@totalh
\newbox\hit@meas@testbox
\newbox\hit@meas@linebox
\newbox\hit@meas@natbox
\newif\ifhit@meas@more
\newif\ifhit@meas@fitok

\def\hit@meas@measure#1#2#3#4{%
  \setbox\hit@meas@testbox=\vbox{%
    \hsize=#2\relax
    \centering
    \fontsize{#3}{#4}\selectfont\bfseries
    \def\newline{\unskip\break\ignorespaces}%
    \let\\\newline
    #1\par
  }%
  \hit@meas@totalh=\dimexpr\ht\hit@meas@testbox+\dp\hit@meas@testbox\relax
  \hit@meas@linecount=0\relax
  \hit@meas@maxlinewidth=0pt\relax
  \setbox\hit@meas@testbox=\vbox{%
    \unvcopy\hit@meas@testbox
    \hit@meas@pop@lines
  }%
}

\def\hit@meas@pop@lines{%
  \loop
    \unskip\unkern\unpenalty
    \setbox\hit@meas@linebox=\lastbox
    \ifvoid\hit@meas@linebox
      \hit@meas@morefalse
    \else
      \hit@meas@moretrue
      \global\advance\hit@meas@linecount by 1\relax
      \setbox\hit@meas@natbox=\hbox{\unhcopy\hit@meas@linebox\unskip\unkern}%
      \ifdim\wd\hit@meas@natbox>\hit@meas@maxlinewidth
        \global\hit@meas@maxlinewidth=\wd\hit@meas@natbox
      \fi
    \fi
  \ifhit@meas@more\repeat
}

\def\hit@check@fit#1#2#3#4#5{%
  \hit@meas@measure{#1}{#2}{#4}{#5}%
  \hit@meas@fitoktrue
  \ifnum\hit@meas@linecount>2\relax \hit@meas@fitokfalse \fi
  \ifdim\hit@meas@maxlinewidth>#2\relax \hit@meas@fitokfalse \fi
  \ifdim\hit@meas@totalh>#3\relax \hit@meas@fitokfalse \fi
}

\def\hit@nav@fsize{7.5}
\def\hit@nav@fskip{9.5}

\def\hit@autofit@nav#1#2#3{%
  % #1=title, #2=target_w, #3=target_h
  \hit@check@fit{#1}{#2}{#3}{7.5}{9.5}%
  \ifhit@meas@fitok
    \def\hit@nav@fsize{7.5}\def\hit@nav@fskip{9.5}%
  \else
    \hit@check@fit{#1}{#2}{#3}{7.0}{8.8}%
    \ifhit@meas@fitok
      \def\hit@nav@fsize{7.0}\def\hit@nav@fskip{8.8}%
    \else
      \hit@check@fit{#1}{#2}{#3}{6.5}{8.2}%
      \ifhit@meas@fitok
        \def\hit@nav@fsize{6.5}\def\hit@nav@fskip{8.2}%
      \else
        \hit@check@fit{#1}{#2}{#3}{6.0}{7.6}%
        \ifhit@meas@fitok
          \def\hit@nav@fsize{6.0}\def\hit@nav@fskip{7.6}%
        \else
          \hit@check@fit{#1}{#2}{#3}{5.5}{7.0}%
          \ifhit@meas@fitok
            \def\hit@nav@fsize{5.5}\def\hit@nav@fskip{7.0}%
          \else
            \hit@check@fit{#1}{#2}{#3}{5.0}{6.4}%
            \ifhit@meas@fitok
              \def\hit@nav@fsize{5.0}\def\hit@nav@fskip{6.4}%
            \else
              \def\hit@nav@fsize{5.0}\def\hit@nav@fskip{6.4}%
              \expandafter\@ifundefined{hit@navwarn@\detokenize{#1}}{%
                \expandafter\gdef\csname hit@navwarn@\detokenize{#1}\endcsname{}%
                \PackageWarning{beamerthemehitminimalist}{%
                  Section title "#1" in navigation exceeds 2 lines even at minimum font size (5pt).\MessageBreak
                  Please consider using \protect\section[short title]{full title} to provide a shorter title%
                }%
              }{}%
            \fi
          \fi
        \fi
      \fi
    \fi
  \fi
}

\def\hit@ol@curfsize{12}
\def\hit@ol@curskip{14}

\def\hit@autofit@outline#1#2#3#4#5{%
  \hit@check@fit{#1}{#2}{#3}{#4}{#5}%
  \ifhit@meas@fitok
    \def\hit@ol@curfsize{#4}\def\hit@ol@curskip{#5}%
  \else
    \hit@autofit@outline@ladder{#1}{#2}{#3}%
  \fi
}

\def\hit@autofit@outline@ladder#1#2#3{%
  \hit@check@fit{#1}{#2}{#3}{11.0}{13.0}%
  \ifhit@meas@fitok \def\hit@ol@curfsize{11.0}\def\hit@ol@curskip{13.0}%
  \else
    \hit@check@fit{#1}{#2}{#3}{10.0}{12.0}%
    \ifhit@meas@fitok \def\hit@ol@curfsize{10.0}\def\hit@ol@curskip{12.0}%
    \else
      \hit@check@fit{#1}{#2}{#3}{9.0}{11.0}%
      \ifhit@meas@fitok \def\hit@ol@curfsize{9.0}\def\hit@ol@curskip{11.0}%
      \else
        \hit@check@fit{#1}{#2}{#3}{8.0}{10.0}%
        \ifhit@meas@fitok \def\hit@ol@curfsize{8.0}\def\hit@ol@curskip{10.0}%
        \else
          \hit@check@fit{#1}{#2}{#3}{7.5}{9.5}%
          \ifhit@meas@fitok \def\hit@ol@curfsize{7.5}\def\hit@ol@curskip{9.5}%
          \else
            \hit@check@fit{#1}{#2}{#3}{7.0}{8.8}%
            \ifhit@meas@fitok \def\hit@ol@curfsize{7.0}\def\hit@ol@curskip{8.8}%
            \else
              \hit@check@fit{#1}{#2}{#3}{6.5}{8.2}%
              \ifhit@meas@fitok \def\hit@ol@curfsize{6.5}\def\hit@ol@curskip{8.2}%
              \else
                \hit@check@fit{#1}{#2}{#3}{6.0}{7.6}%
                \ifhit@meas@fitok \def\hit@ol@curfsize{6.0}\def\hit@ol@curskip{7.6}%
                \else
                  \def\hit@ol@curfsize{6.0}\def\hit@ol@curskip{7.6}%
                  \expandafter\@ifundefined{hit@olwarn@\detokenize{#1}}{%
                    \expandafter\gdef\csname hit@olwarn@\detokenize{#1}\endcsname{}%
                    \PackageWarning{beamerthemehitminimalist}{%
                      Section title "#1" in Outline exceeds capsule boundaries even at 6pt.\MessageBreak
                      Please consider using \protect\section[short title]{full title} to provide a shorter title%
                    }%
                  }{}%
                \fi
              \fi
            \fi
          \fi
        \fi
      \fi
    \fi
  \fi
}

\newcommand{\hit@minimalist@nav}{%
  \ifhit@inappendix
    \begin{tikzpicture}[x=1pt,y=1pt,baseline=0pt]
      \useasboundingbox (0,0) rectangle (\the\hit@navavailwd,\the\hit@headheight);
      \node[anchor=east,inner sep=0pt] at (\the\dimexpr\hit@navavailwd-0.04\paperwidth\relax, 0.5*\the\hit@headheight) {%
        \color{muted}\fontsize{8.5}{11}\selectfont\bfseries APPENDIX%
      };
    \end{tikzpicture}%
  \else
    \hit@nav@count=0\relax
    \def\slideentry##1##2##3##4##5##6{}%
    \def\sectionentry##1##2##3##4##5{%
      \ifnum##5=\c@part\relax
        \advance\hit@nav@count by 1\relax
      \fi
    }%
    \dohead
    \ifnum\hit@nav@count<1\relax
      \begin{tikzpicture}[x=1pt,y=1pt,baseline=0pt]
        \useasboundingbox (0,0) rectangle (\the\hit@navavailwd,\the\hit@headheight);
      \end{tikzpicture}%
    \else
      \hit@nav@cellwd=\dimexpr\hit@navavailwd / \hit@nav@count\relax
      \hit@nav@lastcellwd=\dimexpr\hit@navavailwd - \hit@nav@cellwd * (\hit@nav@count - 1)\relax
      \hit@nav@cur=0\relax
      \hit@nav@prevactive=0\relax
      \def\sectionentry##1##2##3##4##5{%
        \ifnum##5=\c@part\relax
          \advance\hit@nav@cur by 1\relax
          \ifnum\hit@nav@cur=\hit@nav@count
            \dimen@=\hit@nav@lastcellwd
          \else
            \dimen@=\hit@nav@cellwd
          \fi
          \count@=0\relax
          \ifnum\c@section=##1\relax
            \ifnum\c@section>0\relax
              \count@=1\relax
            \fi
          \fi
          \hit@autofit@nav{##2}{\dimexpr\dimen@-4pt\relax}{\dimexpr\hit@headheight-4pt\relax}%
          \hyperlink{Navigation##3}{%
            \begin{tikzpicture}[x=1pt,y=1pt,baseline=0pt]
              \useasboundingbox (0,0) rectangle (\the\dimen@,\the\hit@headheight);
              \clip (0,0) rectangle (\the\dimen@,\the\hit@headheight);
              \ifnum\count@=1\relax
                \fill[brand] (0,0) rectangle (\the\dimen@,\the\hit@headheight);
                \node[inner sep=0pt,text width=\the\dimexpr\dimen@-4pt\relax,align=center,text=white]
                  at (0.5*\the\dimen@, 0.5*\the\hit@headheight) {%
                  \def\newline{\unskip\break\ignorespaces}%
                  \let\\\newline
                  \fontsize{\hit@nav@fsize}{\hit@nav@fskip}\selectfont\bfseries ##2%
                };
              \else
                \fill[canvas] (0,0) rectangle (\the\dimen@,\the\hit@headheight);
                \ifnum\hit@nav@cur>1\relax
                  \ifnum\hit@nav@prevactive=0\relax
                    \draw[linegray,line width=0.5pt] (0, 0.2*\the\hit@headheight) -- (0, 0.8*\the\hit@headheight);
                  \fi
                \fi
                \node[inner sep=0pt,text width=\the\dimexpr\dimen@-4pt\relax,align=center,text=muted]
                  at (0.5*\the\dimen@, 0.5*\the\hit@headheight) {%
                  \def\newline{\unskip\break\ignorespaces}%
                  \let\\\newline
                  \fontsize{\hit@nav@fsize}{\hit@nav@fskip}\selectfont ##2%
                };
              \fi
            \end{tikzpicture}%
          }%
          \hit@nav@prevactive=\count@
        \fi
      }%
      \hbox to \hit@navavailwd{\dohead\hss}%
    \fi
  \fi
}


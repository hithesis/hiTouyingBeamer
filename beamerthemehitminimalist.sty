\newdimen\hit@ol@wtitle

\def\hit@ol@count@section#1#2#3#4#5{%
  \ifnum#5=\c@part\relax
    \advance\hit@nav@count by 1\relax
  \fi
}

\def\hit@ol@prep@section#1#2#3#4#5{%
  \ifnum#5=\c@part\relax
    \hit@autofit@outline{#2}{\dimexpr\hit@ol@wtitle-16pt\relax}{\dimexpr\hit@ol@caph-4pt\relax}{\hit@ol@fsize}{\hit@ol@skip}%
    \expandafter\xdef\csname hit@ol@sz@#1\endcsname{\hit@ol@curfsize}%
    \expandafter\xdef\csname hit@ol@sk@#1\endcsname{\hit@ol@curskip}%
  \fi
}

\def\hit@ol@render@section#1#2#3#4#5{%
  \ifnum#5=\c@part\relax
    \advance\hit@nav@cur by 1\relax
    \pgfmathsetmacro{\yoffset}{(0.5*(\hit@nav@count + 1) - \hit@nav@cur) * \the\hit@ol@pitch / 1pt - 0.5*\the\hit@ol@caph / 1pt}%
    \coordinate (rowB) at ([yshift=\yoffset pt]current page.west);
    % 编号胶囊（带跳转链接）
    \fill[brand,rounded corners=0.5*\the\hit@ol@caph]
      ([xshift=\hit@ol@xnum]rowB) rectangle ++(\the\hit@ol@wnum, \the\hit@ol@caph);
    \node[inner sep=0pt,text=white]
      at ([xshift=\the\dimexpr\hit@ol@xnum+0.5\hit@ol@wnum\relax,yshift=0.5*\the\hit@ol@caph]rowB) {%
      \hyperlink{Navigation#3}{%
        \fontsize{\hit@ol@fsize}{\hit@ol@skip}\selectfont\bfseries
        \ifnum#1<10 0\fi#1%
      }%
    };
    % 标题胶囊（带跳转链接与换行居中支持）
    \fill[brand,rounded corners=0.5*\the\hit@ol@caph]
      ([xshift=\hit@ol@xtitle]rowB) rectangle ++(\the\hit@ol@wtitle, \the\hit@ol@caph);
    \@ifundefined{hit@ol@sz@#1}{%
      \def\hit@ol@curfsize{\hit@ol@fsize}%
      \def\hit@ol@curskip{\hit@ol@skip}%
    }{%
      \edef\hit@ol@curfsize{\csname hit@ol@sz@#1\endcsname}%
      \edef\hit@ol@curskip{\csname hit@ol@sk@#1\endcsname}%
    }%
    \node[inner sep=0pt,text width=\the\dimexpr\hit@ol@wtitle-16pt\relax,align=center,text=white]
      at ([xshift=\the\dimexpr\hit@ol@xtitle+0.5\hit@ol@wtitle\relax,yshift=0.5*\the\hit@ol@caph]rowB) {%
      \hyperlink{Navigation#3}{%
        \def\newline{\unskip\break\ignorespaces}%
        \let\\\newline
        \fontsize{\hit@ol@curfsize}{\hit@ol@curskip}\selectfont\bfseries #2%
      }%
    };
  \fi
}

\def\hit@outline@draw{%
  % 统计当前主章节数 N
  \hit@nav@count=0\relax
  \let\slideentry\hit@ol@slideentry
  \let\sectionentry\hit@ol@count@section
  \dohead

  % 根据章节数 N 动态调整胶囊高度、行距与字号
  \ifcase\hit@nav@count
    \hit@ol@caph=26pt\hit@ol@pitch=50pt\def\hit@ol@fsize{12}\def\hit@ol@skip{14}%
  \or
    \hit@ol@caph=26pt\hit@ol@pitch=50pt\def\hit@ol@fsize{12}\def\hit@ol@skip{14}%
  \or
    \hit@ol@caph=26pt\hit@ol@pitch=50pt\def\hit@ol@fsize{12}\def\hit@ol@skip{14}%
  \or
    \hit@ol@caph=25pt\hit@ol@pitch=46pt\def\hit@ol@fsize{11.5}\def\hit@ol@skip{13.5}%
  \or
    \hit@ol@caph=23pt\hit@ol@pitch=38pt\def\hit@ol@fsize{11}\def\hit@ol@skip{13}%
  \or
    \hit@ol@caph=21pt\hit@ol@pitch=32pt\def\hit@ol@fsize{10}\def\hit@ol@skip{12}%
  \else
    \hit@ol@caph=19pt\hit@ol@pitch=27pt\def\hit@ol@fsize{9}\def\hit@ol@skip{11}%
  \fi

  % 右侧章节胶囊几何参数
  \hit@ol@xnum=0.44\paperwidth
  \hit@ol@wnum=34pt
  \hit@ol@gap=8pt
  \hit@ol@xtitle=\dimexpr\hit@ol@xnum+\hit@ol@wnum+\hit@ol@gap\relax
  \hit@ol@xend=0.94\paperwidth
  \hit@ol@wtitle=\dimexpr\hit@ol@xend-\hit@ol@xtitle\relax

  % 预先在 TikZ 画布外部测量并自适应各章节标题字号与行距
  \let\slideentry\hit@ol@slideentry
  \let\sectionentry\hit@ol@prep@section
  \dohead

  % 开始纯粹的图形与节点绘制
  \begin{tikzpicture}[remember picture,overlay]
    % 浅灰画布背景
    \fill[canvas] (current page.south west) rectangle (current page.north east);

    % 左侧大号 Outline 蓝底区域
    \coordinate (W) at (current page.west);
    \hit@ol@R=0.23\paperheight
    \hit@ol@TotalW=0.32\paperwidth
    \hit@ol@StraightW=\dimexpr\hit@ol@TotalW-\hit@ol@R\relax

    % 浅蓝外沿轮廓
    \fill[borderblue]
      ([yshift=-\hit@ol@R-6.5pt]W) --
      ++(\hit@ol@StraightW, 0)
      arc (-90:90:\dimexpr\hit@ol@R+6.5pt\relax) --
      ([yshift=\hit@ol@R+6.5pt]W) -- cycle;

    % 主色蓝底主体
    \fill[brand]
      ([yshift=-\hit@ol@R]W) --
      ++(\hit@ol@StraightW, 0)
      arc (-90:90:\hit@ol@R) --
      ([yshift=\hit@ol@R]W) -- cycle;

    % 蓝底内水平垂直居中大号白色 Outline 标题
    \node[text=white,inner sep=0pt] at ([xshift=0.5\hit@ol@TotalW]W) {%
      \fontsize{24}{28}\selectfont\bfseries \hitoutlinetitle%
    };

    % 逐章排版编号胶囊与标题胶囊，垂直居中排布
    \hit@nav@cur=0\relax
    \let\sectionentry\hit@ol@render@section
    \dohead
  \end{tikzpicture}%
}

\def\hit@ol@slideentry#1#2#3#4#5#6{}

\newcommand{\hit@outline@minimalist}{%
  \begin{frame}[plain,noframenumbering]
    \setbeamertemplate{navigation symbols}{}%
    \hit@outline@draw
  \end{frame}}

% ------------------------------------------------------------- focus slide ----
\long\def\hit@focuspage#1{%
  \setbeamercolor{background canvas}{bg=brand}%
  \begin{frame}[plain,noframenumbering]
    \color{white}\vspace{6mm}
    {\fontsize{25}{34}\selectfont\bfseries #1\par}\vspace{6mm}
    {\color{borderblue}\rule{3cm}{2pt}}
  \end{frame}}

% -------------------------------------------------------------- end slides ----
% 致谢页采用三段结构：上方居中校徽，中部通栏蓝带与白色致谢文字，下方通用作者/单位信息。
\long\def\hit@endpage#1{%
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture,overlay]
      % 顶部校徽
      \node[inner sep=0pt] at ([yshift=-0.16\paperheight]current page.north)
        {\includegraphics[width=4.8cm,height=0.18\paperheight,keepaspectratio]{\hit@logopath}};
      % 中部通栏主色带
      \fill[brand] (current page.south west) ++(0, 0.26\paperheight) rectangle ++(\paperwidth, 0.42\paperheight);
      % 色带内居中白色致谢文字
      \node[inner sep=0pt,text=white] at ([yshift=0.47\paperheight]current page.south) {%
        \parbox[c][0.42\paperheight][c]{0.88\paperwidth}{\centering\fontsize{28}{36}\selectfont\bfseries #1}%
      };
      % 底部通用信息（作者与单位均非空时并排显示；为空时静默省略）
      \node[inner sep=0pt,text=brand,align=center] at ([yshift=0.13\paperheight]current page.south) {%
        \fontsize{9.5}{13}\selectfont
        \ifx\insertauthor\@empty\else\insertauthor\fi
        \ifx\insertinstitute\@empty\else
          \ifx\insertauthor\@empty\else\quad\fi
          \insertinstitute
        \fi
      };
    \end{tikzpicture}%
  \end{frame}}

\mode<all>
\endinput
